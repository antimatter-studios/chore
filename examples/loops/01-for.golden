$ chore build:all
# a list: one task call per item
building libext4.a
building libntfs.a
building libxfs.a
exit 0

$ chore ports
# a map: the key and the value, in written order
worker listens on 9090
api listens on 8080
exit 0

$ chore unload
# a string splits on whitespace
unload com.roguetrader.tick.plist
unload com.roguetrader.analyst.plist
unload com.roguetrader.auditor.plist
exit 0

$ chore build:all DRIVERS=btrfs squashfs
# the command line replaces the list
building libbtrfs.a
building libsquashfs.a
exit 0

$ chore build:all DRIVERS=ext4 broken xfs
# the first failure stops the loop
building libext4.a
building libbroken.a
(stderr) chore: build: failing step:
(stderr)     test broken != broken
(stderr) chore: build:all: for ITEM="broken": build: exit status 1
exit 1
